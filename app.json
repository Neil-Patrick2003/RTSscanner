{
  "expo": {
    "name": "RTSscanner",
    "slug": "RTSscanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rtsscanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.neilpatrick.RTSscanner"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo/rts-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RTS Scanner to use the camera to scan return QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#047857",
          "image": "./assets/images/logo/artemis-logo.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#047857"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b659f4eb-cb8b-4907-a440-3d1949c91942"
      }
    }
  }
}
